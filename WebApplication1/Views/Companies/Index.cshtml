@model IEnumerable<WebApplication1.Models.Company>
@using WebApplication1.Extensions
@{ ViewData["Title"] = "Компанії"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Компанії</h2>
    @if (User.IsInRole(RoleNames.Admin))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm">Додати компанію</a>
    }
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-borderless align-middle mb-0">
            <thead class="table-light">
                <tr><th>Назва</th><th>Сайт</th><th>Локація</th><th class="text-end">Дії</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.Name</td>
                    <td><a href="@item.Website" target="_blank">@item.Website</a></td>
                    <td>@item.Location</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
