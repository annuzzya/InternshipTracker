@model IEnumerable<WebApplication1.Models.Company>

@{
    ViewData["Title"] = "Компанії";
}

<h1>Список компаній</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Додати нову компанію</a>
</p>
<table class="table table-striped">
    <thead>
    <tr> <th>Назва</th>
        <th>Сайт</th>
        <th>Локація</th>
        <th>Дії</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.Name</td>
            <td>@item.Website</td>
            <td>@item.Location</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Деталі</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Видалити</a>
            </td>
        </tr>
    }
    </tbody>
</table>