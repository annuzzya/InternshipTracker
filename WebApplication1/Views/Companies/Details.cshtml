@model WebApplication1.Models.Company
@{ ViewData["Title"] = "Компанія: " + Model.Name; }

<div class="container-fluid px-4 mt-4">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex align-items-center gap-4 mb-5 pb-4 border-bottom">
                        <div class="bg-primary text-white rounded-4 d-flex align-items-center justify-content-center shadow-sm" style="width: 100px; height: 100px; min-width: 100px;">
                            <i class="bi bi-building fs-1"></i>
                        </div>
                        <div>
                            <h1 class="fw-bold mb-2">@Model.Name</h1>
                            <div class="d-flex gap-3">
                                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Location
                                </span>
                                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                                    <i class="bi bi-check-circle-fill text-success me-1"></i> Перевірена компанія
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-12">
                            <h5 class="fw-bold mb-3">Про компанію</h5>
                            <p class="text-muted fs-5 lh-base">
                                Це офіційна сторінка компанії <strong>@Model.Name</strong>. Тут ви можете знайти контактну інформацію та актуальні дані про локацію офісу. Компанія зареєстрована в системі під унікальним ідентифікатором.
                            </p>
                        </div>
                        
                        <div class="col-md-6 mt-4">
                            <div class="p-3 bg-light rounded-3 border-start border-primary border-4">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Офіційний сайт</label>
                                <a href="@Model.Website" target="_blank" class="fs-5 fw-bold text-decoration-none">
                                    <i class="bi bi-box-arrow-up-right me-2"></i>Перейти на сайт
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Контакти та системні дані</h5>
                    
                    <div class="mb-3">
                        <label class="text-muted small fw-bold text-uppercase d-block mb-1">Локація</label>
                        <p class="fw-medium"><i class="bi bi-map me-2"></i>@Model.Location</p>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small fw-bold text-uppercase d-block mb-1">Пряме посилання</label>
                        <p class="small text-primary text-break">@Model.Website</p>
                    </div>

                    <div class="mb-4 p-3 bg-light rounded-3">
                        <label class="text-muted small fw-bold text-uppercase d-block mb-1">Системний GUID</label>
                        <code class="small">@Model.Id</code>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg rounded-pill fw-bold text-white shadow-sm hover-lift">
                            <i class="bi bi-pencil-square me-2"></i>Редагувати дані
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill fw-bold mt-2">
                            <i class="bi bi-arrow-left me-2"></i>До списку компаній
                        </a>
                    </div>
                </div>
            </div>

            <div class="card bg-primary text-white border-0 rounded-4 shadow-sm">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-info-circle fs-2 mb-3"></i>
                    <h6>Потрібна допомога?</h6>
                    <p class="small opacity-75 mb-0">Якщо дані компанії застаріли, ви можете оновити їх у розділі редагування або звернутися до адміністратора.</p>
                </div>
            </div>
        </div>
    </div>
</div>