@model WebApplication1.Models.Company
@{ ViewData["Title"] = "Деталі компанії"; }
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm"><div class="card-body p-4">
            <h2 class="h4 mb-4">Деталі компанії</h2>
            <dl class="row mb-0">
                <dt class="col-sm-3">Назва</dt><dd class="col-sm-9">@Model.Name</dd>
                <dt class="col-sm-3">Сайт</dt><dd class="col-sm-9">@Model.Website</dd>
                <dt class="col-sm-3">Локація</dt><dd class="col-sm-9">@Model.Location</dd>
            </dl>
        </div></div>
    </div>
</div>
