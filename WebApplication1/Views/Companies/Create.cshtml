@model WebApplication1.Models.Company

@{
    ViewData["Title"] = "Створити";
}

<h1>Додати компанію</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="form-group mb-3">
                <label class="control-label">Назва компанії</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Сайт</label>
                <input asp-for="Website" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Локація</label>
                <input asp-for="Location" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Зберегти" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Повернутися до списку</a>
            </div>
        </form>
    </div>
</div>