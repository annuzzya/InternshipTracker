@model WebApplication1.Models.Company

@{
    ViewData["Title"] = "Видалення";
}

<h1 class="text-danger">Видалити компанію</h1>

<h3>Ви впевнені, що хочете видалити цю компанію?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Назва</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        
        <dt class="col-sm-2">Сайт</dt>
        <dd class="col-sm-10">@Model.Website</dd>
        
        <dt class="col-sm-2">Локація</dt>
        <dd class="col-sm-10">@Model.Location</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Так, видалити" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>