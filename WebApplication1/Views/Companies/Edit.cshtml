@model WebApplication1.Models.Company
@{ ViewData["Title"] = "Редагування компанії"; }

<div class="container-fluid px-4 mt-4">
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-4 h-100">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex align-items-center gap-4 mb-5 pb-4 border-bottom">
                            <div class="bg-warning text-white rounded-4 d-flex align-items-center justify-content-center shadow" style="width: 80px; height: 80px;">
                                <i class="bi bi-building fs-1"></i>
                            </div>
                            <h2 class="fw-bold m-0">Параметри компанії</h2>
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Назва організації</label>
                            <input asp-for="Name" class="form-control form-control-lg bg-light border-0 shadow-sm" required />
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small text-uppercase">Локація офісу</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0 text-danger"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Location" class="form-control bg-light border-0 shadow-sm" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small text-uppercase">Офіційний веб-сайт</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0 text-primary"><i class="bi bi-globe"></i></span>
                                    <input asp-for="Website" class="form-control bg-light border-0 shadow-sm" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 rounded-4 p-4">
                    <h5 class="fw-bold mb-4">Підтвердження</h5>
                    <p class="text-muted small mb-4">Переконайтеся, що дані компанії актуальні. Ці зміни миттєво відобразяться на сторінках усіх пов'язаних вакансій.</p>
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning btn-lg rounded-pill fw-bold text-white shadow-sm hover-lift">
                            <i class="bi bi-save me-2"></i>Оновити дані
                        </button>
                        <a asp-action="Index" class="btn btn-light btn-lg rounded-pill fw-bold border mt-2">
                            Назад
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>