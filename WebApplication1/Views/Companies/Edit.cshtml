@model WebApplication1.Models.Company

@{
    ViewData["Title"] = "Редагувати компанію";
}

<h1>Редагувати компанію</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group mb-3">
                <label class="control-label">Назва компанії</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Сайт</label>
                <input asp-for="Website" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Локація</label>
                <input asp-for="Location" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Зберегти зміни" class="btn btn-warning" />
                <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
            </div>
        </form>
    </div>
</div>