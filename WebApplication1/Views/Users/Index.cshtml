@model IEnumerable<WebApplication1.Models.User>
@{ ViewData["Title"] = "Користувачі"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Користувачі</h2>
    <a asp-action="Create" class="btn btn-primary btn-sm">Додати користувача</a>
</div>
<div class="card shadow-sm"><div class="table-responsive">
<table class="table table-hover table-borderless align-middle mb-0">
<thead class="table-light"><tr><th>ПІБ</th><th>Email</th><th>Роль</th><th class="text-end">Дії</th></tr></thead>
<tbody>
@foreach (var item in Model) {
<tr><td>@item.FullName</td><td>@item.Email</td><td>@item.Role</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr>
}
</tbody></table></div></div>
