@model WebApplication1.Models.User
@{ ViewData["Title"] = "Деталі користувача"; }
<div class="row justify-content-center"><div class="col-md-8"><div class="card shadow-sm"><div class="card-body p-4">
<h2 class="h4 mb-4">Деталі користувача</h2>
<dl class="row mb-0">
<dt class="col-sm-3">ПІБ</dt><dd class="col-sm-9">@Model.FullName</dd>
<dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
<dt class="col-sm-3">Роль</dt><dd class="col-sm-9">@Model.Role</dd>
<dt class="col-sm-3">CompanyId</dt><dd class="col-sm-9">@Model.CompanyId</dd>
</dl>
</div></div></div></div>
