@model WebApplication1.Models.User
@{ ViewData["Title"] = "Деталі користувача"; }

<h1>@Model.FullName</h1>
<hr />
<dl class="row">
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    
    <dt class="col-sm-3">Роль</dt>
    <dd class="col-sm-9">@Model.Role</dd>
    
    <dt class="col-sm-3">Дата реєстрації</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy")</dd>
</dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
    <a asp-action="Index" class="btn btn-secondary">Повернутися до списку</a>
</div>