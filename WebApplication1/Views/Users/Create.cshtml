@model WebApplication1.Models.User

@{
    ViewData["Title"] = "Створити";
}

<h1>Додати користувача</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="form-group mb-3">
                <label class="control-label">Email</label>
                <input asp-for="Email" class="form-control" required type="email" />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">ПІБ</label>
                <input asp-for="FullName" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Роль</label>
                <input asp-for="Role" class="form-control" required placeholder="Student, Recruiter або Mentor" />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">ID Компанії</label>
                <input asp-for="CompanyId" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Зберегти" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Повернутися</a>
            </div>
        </form>
    </div>
</div>