@model WebApplication1.Models.Vacancy
@{ ViewData["Title"] = "Видалення"; }

<h1 class="text-danger">Видалити вакансію</h1>
<h3>Ви впевнені, що хочете видалити вакансію "@Model.Title"?</h3>
<div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Так, видалити" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>