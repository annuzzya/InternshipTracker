@model IEnumerable<WebApplication1.Models.Vacancy>

@{
    ViewData["Title"] = "Вакансії";
}

<h1>Список вакансій</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Додати нову вакансію</a>
</p>
<table class="table table-striped">
    <thead>
    <tr>
        <th>Назва</th>
        <th>Зарплата (Мін - Макс)</th>
        <th>Валюта</th>
        <th>Посилання</th>
        <th>Дії</th> </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.Title</td>
            <td>@item.SalaryMin - @item.SalaryMax</td>
            <td>@item.Currency</td>
            <td>@item.Link</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Деталі</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Редагувати</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Видалити</a>
            </td>
        </tr>
    }
    </tbody>
</table>