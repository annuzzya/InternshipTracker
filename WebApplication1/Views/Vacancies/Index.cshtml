@model IEnumerable<WebApplication1.Models.Vacancy>
@using WebApplication1.Extensions
@{ ViewData["Title"] = "Вакансії"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Вакансії</h2>
    @if (User.IsInRole(RoleNames.Admin)) { <a asp-action="Create" class="btn btn-primary btn-sm">Додати вакансію</a> }
</div>
<div class="card shadow-sm"><div class="table-responsive">
<table class="table table-hover table-borderless align-middle mb-0">
<thead class="table-light"><tr><th>Назва</th><th>ЗП</th><th>Статус</th><th class="text-end">Дії</th></tr></thead>
<tbody>
@foreach (var item in Model) {
<tr>
<td class="fw-semibold">@item.Title</td>
<td>@(item.SalaryMin != null ? $"{item.SalaryMin} - {item.SalaryMax} {item.Currency}" : "Не вказано")</td>
<td>@item.StatusId</td>
<td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
@if (User.IsInRole(RoleNames.Admin)) {<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>}</td>
</tr>
}
</tbody></table></div></div>
