@model WebApplication1.Models.Vacancy
@{ ViewData["Title"] = "Деталі вакансії"; }
<div class="row justify-content-center"><div class="col-md-8"><div class="card shadow-sm"><div class="card-body p-4">
<h2 class="h4 mb-4">Деталі вакансії</h2>
<dl class="row mb-0">
<dt class="col-sm-4">Назва</dt><dd class="col-sm-8">@Model.Title</dd>
<dt class="col-sm-4">Зарплата</dt><dd class="col-sm-8">@(Model.SalaryMin != null ? $"{Model.SalaryMin} - {Model.SalaryMax} {Model.Currency}" : "Не вказано")</dd>
<dt class="col-sm-4">Посилання</dt><dd class="col-sm-8 text-break">@Model.Link</dd>
<dt class="col-sm-4">Статус</dt><dd class="col-sm-8">@Model.StatusId</dd>
</dl>
</div></div></div></div>
