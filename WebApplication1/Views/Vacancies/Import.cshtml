@{
    ViewData["Title"] = "Імпорт вакансій";
}

<h2 class="mb-4">Імпорт вакансій з Excel</h2>

<div class="row">
    <div class="col-12 col-md-8 col-lg-6">
        @using (Html.BeginForm("Import", "Vacancies", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label for="vacanciesFile" class="form-label">Оберіть файл для завантаження</label>
                <input type="file" name="vacanciesFile" id="vacanciesFile" class="form-control" accept=".xlsx" />
            </div>
            <div>
                <input class="btn btn-primary" type="submit" value="Завантажити" />
                <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
            </div>
        }
    </div>
</div>
