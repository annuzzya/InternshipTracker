@model WebApplication1.Models.Vacancy
@{ ViewData["Title"] = "Додати вакансію"; }

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-briefcase-fill fs-3"></i>
                    </div>
                    <h3 class="fw-bold">Публікація вакансії</h3>
                </div>
                
                <form asp-action="Create">
                    <div class="form-group mb-3">
                        <label class="control-label fw-bold text-muted small mb-1">Назва вакансії</label>
                        <input asp-for="Title" class="form-control form-control-lg bg-light border-0" required placeholder="Trainee .NET Developer" />
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="control-label fw-bold text-muted small mb-1">Компанія</label>
                            <select asp-for="CompanyId" class="form-select form-select-lg bg-light border-0" asp-items="ViewBag.CompanyId">
                                <option value="">Оберіть компанію</option>
                            </select>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label class="control-label fw-bold text-muted small mb-1">Автор публікації</label>
                            <select asp-for="AuthorId" class="form-select form-select-lg bg-light border-0" asp-items="ViewBag.AuthorId">
                                <option value="">Оберіть автора</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 form-group mb-3">
                            <label class="control-label fw-bold text-muted small mb-1">Статус</label>
                            <select asp-for="StatusId" class="form-select form-select-lg bg-light border-0" asp-items="ViewBag.StatusId"></select>
                        </div>
                        <div class="col-md-4 form-group mb-3">
                            <label class="control-label fw-bold text-muted small mb-1">Мін. ЗП</label>
                            <input asp-for="SalaryMin" class="form-control form-control-lg bg-light border-0" type="number" placeholder="400" />
                        </div>
                        <div class="col-md-4 form-group mb-3">
                            <label class="control-label fw-bold text-muted small mb-1">Макс. ЗП</label>
                            <input asp-for="SalaryMax" class="form-control form-control-lg bg-light border-0" type="number" placeholder="800" />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4 form-group mb-3">
                            <label class="control-label fw-bold text-muted small mb-1">Валюта</label>
                            <input asp-for="Currency" class="form-control form-control-lg bg-light border-0" placeholder="USD" />
                        </div>
                        <div class="col-md-8 form-group mb-4">
                            <label class="control-label fw-bold text-muted small mb-1">Посилання на деталі</label>
                            <input asp-for="Link" class="form-control form-control-lg bg-light border-0" placeholder="https://djinni.co/..." />
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-2">
                        <button type="submit" class="btn btn-success btn-lg w-50 fw-bold shadow-sm"><i class="bi bi-check-lg me-1"></i> Опублікувати</button>
                        <a asp-action="Index" class="btn btn-light btn-lg w-50 fw-bold border">Скасувати</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>