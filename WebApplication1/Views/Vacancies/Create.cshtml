@model WebApplication1.Models.Vacancy
@{ ViewData["Title"] = "Додати вакансію"; }

<div class="container-fluid px-4 mt-4">
    <form asp-action="Create">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                            <div class="bg-primary-subtle text-primary rounded-3 p-3">
                                <i class="bi bi-plus-circle fs-2"></i>
                            </div>
                            <h2 class="fw-bold m-0">Створення вакансії</h2>
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Назва вакансії</label>
                            <input asp-for="Title" class="form-control form-control-lg bg-light border-0 shadow-sm" placeholder="Наприклад: Junior .NET Developer" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small text-uppercase">Мінімальна ЗП</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0 text-success"><i class="bi bi-cash"></i></span>
                                    <input asp-for="SalaryMin" class="form-control bg-light border-0 shadow-sm" type="number" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small text-uppercase">Максимальна ЗП</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0 text-success"><i class="bi bi-cash-stack"></i></span>
                                    <input asp-for="SalaryMax" class="form-control bg-light border-0 shadow-sm" type="number" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label fw-bold text-muted small text-uppercase">Посилання на повний опис</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-0 text-primary"><i class="bi bi-link-45deg"></i></span>
                                <input asp-for="Link" class="form-control bg-light border-0 shadow-sm" placeholder="https://djinni.co/..." />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4 border-bottom pb-2">Параметри публікації</h5>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small text-uppercase">Статус</label>
                            <select asp-for="StatusId" class="form-select bg-light border-0 shadow-sm" asp-items="ViewBag.StatusId"></select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small text-uppercase">Валюта</label>
                            <input asp-for="Currency" class="form-control bg-light border-0 shadow-sm" placeholder="USD" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small text-uppercase">Компанія</label>
                            <select asp-for="CompanyId" class="form-select bg-light border-0 shadow-sm" asp-items="ViewBag.CompanyId"></select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Автор публікації</label>
                            <select asp-for="AuthorId" class="form-select bg-light border-0 shadow-sm" asp-items="ViewBag.AuthorId"></select>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm hover-lift">
                                <i class="bi bi-plus-circle me-2"></i>Створити вакансію
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill fw-bold mt-2">
                                Скасувати
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>