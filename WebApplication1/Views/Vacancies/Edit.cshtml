@model WebApplication1.Models.Vacancy
@{ ViewData["Title"] = "Редагувати вакансію"; }

<h1>Редагувати вакансію</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" /> <div class="form-group mb-3">
                <label class="control-label">Назва вакансії</label>
                <input asp-for="Title" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Компанія</label>
                <select asp-for="CompanyId" class="form-control" asp-items="ViewBag.CompanyId"></select>
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Автор</label>
                <select asp-for="AuthorId" class="form-control" asp-items="ViewBag.AuthorId"></select>
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Статус</label>
                <select asp-for="StatusId" class="form-control" asp-items="ViewBag.StatusId"></select>
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Мін. зарплата</label>
                <input asp-for="SalaryMin" class="form-control" type="number" />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Макс. зарплата</label>
                <input asp-for="SalaryMax" class="form-control" type="number" />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Валюта</label>
                <input asp-for="Currency" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Посилання</label>
                <input asp-for="Link" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Зберегти зміни" class="btn btn-warning" />
                <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
            </div>
        </form>
    </div>
</div>