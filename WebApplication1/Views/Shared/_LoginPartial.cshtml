@using Microsoft.AspNetCore.Identity
@using WebApplication1.Data.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-lg-3 align-items-lg-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item me-2">
        <span class="nav-link text-dark">Привіт, @UserManager.GetUserName(User)</span>
    </li>
    <li class="nav-item">
        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="btn btn-outline-secondary rounded-pill">Вийти</button>
        </form>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="btn btn-outline-primary rounded-pill" id="register" asp-area="Identity" asp-page="/Account/Register">Реєстрація</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary rounded-pill" id="login" asp-area="Identity" asp-page="/Account/Login">Вхід</a>
    </li>
}
</ul>
