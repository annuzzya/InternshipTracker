<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InternTracker</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/zephyr/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        body { background-color: #f4f6f9; display: flex; flex-direction: column; min-height: 100vh; }
        main { flex: 1; }
        
        /* СУЧАСНІ СТИЛІ ДЛЯ НОВОГО ХЕДЕРА */
        .glass-header {
            background-color: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        .brand-logo-box {
            width: 40px; height: 40px;
            background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        }
        .tracking-tight { letter-spacing: -0.5px; }
        .nav-link-custom {
            font-weight: 600;
            color: #495057 !important;
            border-radius: 50rem;
            padding: 0.5rem 1.2rem !important;
            transition: all 0.2s ease-in-out;
        }
        .nav-link-custom:hover {
            background-color: #f8f9fa;
            color: #0d6efd !important;
        }
        .admin-dropdown-menu {
            min-width: 240px;
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 10px 30px rgba(0,0,0,0.08) !important;
        }
        .admin-dropdown-menu .dropdown-item {
            padding: 0.6rem 1rem;
            border-radius: 0.5rem;
            font-weight: 500;
            transition: all 0.2s;
        }
        .admin-dropdown-menu .dropdown-item:hover {
            background-color: #f8f9fa;
            transform: translateX(3px);
        }
    </style>
</head>
<body>
    
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg glass-header py-3 shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <div class="brand-logo-box text-white rounded d-flex align-items-center justify-content-center shadow-sm">
                        <i class="bi bi-rocket-takeoff-fill"></i>
                    </div>
                    <span class="fs-4 fw-bolder text-dark tracking-tight">Intern<span class="text-primary">Tracker</span></span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Companies" asp-action="Index">
                                <i class="bi bi-buildings me-1 text-muted"></i> Компанії
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Vacancies" asp-action="Index">
                                <i class="bi bi-briefcase me-1 text-muted"></i> Вакансії
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                    
                    <ul class="navbar-nav ms-lg-4">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle btn btn-light rounded-pill px-4 fw-bold text-dark border shadow-sm d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-shield-lock-fill text-primary me-2"></i> Адмінка
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end admin-dropdown-menu rounded-4 p-2 mt-3">
                                <li><span class="dropdown-header fw-bold text-uppercase small text-muted"><i class="bi bi-gear me-1"></i> Керування базою</span></li>
                                <li><a class="dropdown-item mb-1" asp-controller="Users" asp-action="Index"><i class="bi bi-people me-2 text-primary"></i>Всі користувачі</a></li>
                                <li><hr class="dropdown-divider mx-2 my-2"></li>
                                <li><span class="dropdown-header fw-bold text-uppercase small text-muted"><i class="bi bi-lightning-charge me-1"></i> Швидкі дії</span></li>
                                <li><a class="dropdown-item mb-1" asp-controller="Companies" asp-action="Create"><i class="bi bi-building-add me-2 text-success"></i>Додати компанію</a></li>
                                <li><a class="dropdown-item" asp-controller="Vacancies" asp-action="Create"><i class="bi bi-briefcase-fill me-2 text-success"></i>Додати вакансію</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white mt-auto py-4">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                &copy; 2026 - <span class="fw-bold text-dark">InternTracker</span>
            </div>
            <div class="small">
                Створено для найкращого старту кар'єри 🚀
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>