@using WebApplication1.Extensions
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InternTracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-shell">
<header class="border-bottom bg-white sticky-top shadow-sm">
    <nav class="navbar navbar-expand-lg navbar-light">
        <div class="container py-2">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="badge bg-primary rounded-pill p-2"><i class="bi bi-briefcase-fill"></i></span>
                <span>InternTracker</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-2">
                    @if (User.IsInRole(RoleNames.Admin))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Companies" asp-action="Index">Companies</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Vacancies" asp-action="Index">Technologies/Vacancies</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">All Users</a></li>
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Vacancies" asp-action="Index">My Applications</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Vacancies" asp-action="Index">Interviews</a></li>
                    }
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
</header>

<main class="container py-4 py-lg-5">
    @RenderBody()
</main>

<footer class="mt-auto border-top bg-white py-4">
    <div class="container d-flex flex-column flex-md-row justify-content-between gap-2 text-muted">
        <span>© @DateTime.UtcNow.Year InternTracker</span>
        <span class="small">Personal Internship & Job Application Tracker</span>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
