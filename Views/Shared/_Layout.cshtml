<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InternTracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root { --brand: #4f46e5; --brand-soft: #eef2ff; }
        body { background: #f8f9fc; min-height: 100vh; }
        .navbar { background: #fff !important; border-bottom: 1px solid #e5e7eb; }
        .navbar-brand { font-size: 1.2rem; color: var(--brand) !important; }
        .nav-link { color: #374151 !important; font-weight: 500; border-radius: 8px; padding: 6px 12px !important; transition: background .15s; }
        .nav-link:hover, .nav-link.active { background: var(--brand-soft); color: var(--brand) !important; }
        .nav-link.active { font-weight: 700; }
        .btn-primary { background: var(--brand); border-color: var(--brand); }
        .btn-primary:hover { background: #4338ca; border-color: #4338ca; }
        .card { border-radius: 16px !important; }
        .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .hover-lift:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.12) !important; }
        .badge { font-weight: 600; }
        footer { font-size: .875rem; }
    </style>
</head>
<body>
<header class="sticky-top shadow-sm">
    <nav class="navbar navbar-expand-lg navbar-light">
        <div class="container py-2">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="badge rounded-pill p-2" style="background:var(--brand)"><i class="bi bi-briefcase-fill"></i></span>
                InternTracker
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1 ms-3">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i>Дашборд
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Companies" ? "active" : "")"
                           asp-controller="Companies" asp-action="Index">
                            <i class="bi bi-buildings me-1"></i>Компанії
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vacancies" ? "active" : "")"
                           asp-controller="Vacancies" asp-action="Index">
                            <i class="bi bi-briefcase me-1"></i>Вакансії
                        </a>
                    </li>
                    @if (User.IsInRole(RoleNames.Admin))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
                               asp-controller="Users" asp-action="Index">
                                <i class="bi bi-people me-1"></i>Користувачі
                            </a>
                        </li>
                    }
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
</header>

<main class="container py-4 py-lg-5">
    @RenderBody()
</main>

<footer class="mt-auto border-top bg-white py-4">
    <div class="container d-flex flex-column flex-md-row justify-content-between gap-2 text-muted">
        <span>© @DateTime.UtcNow.Year <strong>InternTracker</strong></span>
        <span class="small">Система трекінгу практик та стажувань</span>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
