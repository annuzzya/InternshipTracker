@model WebApplication1.Models.Company
@{ ViewData["Title"] = "Додати компанію"; }

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:60px;height:60px;">
                        <i class="bi bi-building-add fs-3"></i>
                    </div>
                    <h3 class="fw-bold">Додати нову компанію</h3>
                </div>

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 d-none" id="valSummary"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label fw-bold text-muted small text-uppercase mb-1"></label>
                        <input asp-for="Name" class="form-control form-control-lg bg-light border-0 shadow-sm"
                               placeholder="Наприклад: Genesis" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Website" class="form-label fw-bold text-muted small text-uppercase mb-1"></label>
                        <input asp-for="Website" class="form-control form-control-lg bg-light border-0 shadow-sm"
                               placeholder="https://..." />
                        <span asp-validation-for="Website" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="Location" class="form-label fw-bold text-muted small text-uppercase mb-1"></label>
                        <input asp-for="Location" class="form-control form-control-lg bg-light border-0 shadow-sm"
                               placeholder="Київ, Україна" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-success btn-lg w-50 fw-bold shadow-sm rounded-pill">
                            <i class="bi bi-check-lg me-1"></i>Створити
                        </button>
                        <a asp-action="Index" class="btn btn-light btn-lg w-50 fw-bold border rounded-pill">Скасувати</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
