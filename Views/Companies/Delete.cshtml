@model WebApplication1.Models.Company
@{ ViewData["Title"] = "Видалити компанію"; }

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-danger text-white p-4 text-center">
                <div class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                    <i class="bi bi-building-x fs-2"></i>
                </div>
                <h4 class="fw-bold mb-0">Підтвердження видалення</h4>
            </div>
            <div class="card-body p-4">
                <p class="text-muted text-center mb-4">Ви збираєтесь видалити компанію. Цю дію не можна скасувати.</p>

                <div class="bg-light rounded-3 p-3 mb-4">
                    <div class="mb-2">
                        <span class="text-muted small fw-bold text-uppercase">Назва</span>
                        <p class="fw-bold mb-0 text-dark">@Model.Name</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <div class="mb-2">
                            <span class="text-muted small fw-bold text-uppercase">Сайт</span>
                            <p class="mb-0 text-primary">@Model.Website</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Локація</span>
                            <p class="mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.Location</p>
                        </div>
                    }
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-trash3 me-2"></i>Так, видалити
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill fw-bold">
                            <i class="bi bi-arrow-left me-2"></i>Скасувати
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
