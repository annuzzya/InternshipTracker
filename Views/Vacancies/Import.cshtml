@{ ViewData["Title"] = "Імпорт вакансій"; }

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white p-4 text-center">
                <div class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                    <i class="bi bi-file-earmark-spreadsheet fs-2"></i>
                </div>
                <h4 class="fw-bold mb-1">Імпорт вакансій з Excel</h4>
                <p class="opacity-75 small mb-0">Завантажте файл .xlsx для автоматичного додавання даних</p>
            </div>
            <div class="card-body p-4 p-md-5">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-3 mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @Html.ValidationSummary(false)
                    </div>
                }

                @using (Html.BeginForm("Import", "Vacancies", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label for="vacanciesFile" class="form-label fw-bold text-muted small text-uppercase">Оберіть Excel-файл</label>
                        <div class="border-2 border-dashed rounded-4 p-4 text-center bg-light" style="border-style: dashed !important; cursor: pointer;" onclick="document.getElementById('vacanciesFile').click()">
                            <i class="bi bi-cloud-upload fs-1 text-primary opacity-50 d-block mb-2"></i>
                            <p class="text-muted mb-2 small">Натисніть, щоб обрати або перетягніть файл</p>
                            <span class="badge bg-light text-muted border small" id="fileNameBadge">Файл не обрано</span>
                        </div>
                        <input type="file" name="vacanciesFile" id="vacanciesFile" class="d-none" accept=".xlsx" required
                               onchange="document.getElementById('fileNameBadge').textContent = this.files[0]?.name || 'Файл не обрано'" />
                    </div>

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <p class="fw-bold small mb-2"><i class="bi bi-info-circle-fill text-primary me-1"></i>Очікуваний формат файлу:</p>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>A</th><th>B</th><th>C</th><th>D</th><th>E</th><th>F</th><th>G</th><th>H</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="text-muted">
                                        <td>Назва</td><td>Компанія</td><td>Автор</td><td>Статус (1/2/3)</td>
                                        <td>Мін. ЗП</td><td>Макс. ЗП</td><td>Валюта</td><td>Посилання</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-upload me-2"></i>Завантажити та імпортувати
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill fw-bold">
                            <i class="bi bi-arrow-left me-2"></i>Скасувати
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
