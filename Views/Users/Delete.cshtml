@model WebApplication1.Models.User
@{ ViewData["Title"] = "Видалити користувача"; }

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-danger text-white p-4 text-center">
                <div class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                    <i class="bi bi-person-x-fill fs-2"></i>
                </div>
                <h4 class="fw-bold mb-0">Підтвердження видалення</h4>
            </div>
            <div class="card-body p-4">
                <p class="text-muted text-center mb-4">Ви збираєтесь видалити цього користувача. Цю дію не можна скасувати.</p>

                <div class="d-flex align-items-center gap-3 bg-light rounded-3 p-3 mb-4">
                    <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0" style="width:48px;height:48px;font-size:20px;">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <p class="fw-bold mb-0">@Model.FullName</p>
                        <p class="text-muted small mb-0">@Model.Email</p>
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 mt-1">@Model.Role</span>
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-trash3 me-2"></i>Так, видалити
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill fw-bold">
                            <i class="bi bi-arrow-left me-2"></i>Скасувати
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
