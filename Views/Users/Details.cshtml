@model WebApplication1.Models.User
@{ ViewData["Title"] = "Профіль: " + Model.FullName; }

<div class="container-fluid px-4 mt-4">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 text-center p-4 h-100">
                <div class="card-body">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-4 shadow" style="width: 120px; height: 120px; font-size: 50px; font-weight: 800;">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                    <h2 class="fw-bold mb-1">@Model.FullName</h2>
                    <p class="text-muted mb-4">@Model.Email</p>
                    <div class="d-grid gap-2">
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill py-2 fs-6">
                            Роль: @Model.Role
                        </span>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill fw-bold text-white mt-3 shadow-sm hover-lift">
                            <i class="bi bi-pencil-square me-2"></i>Редагувати профіль
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4 p-md-5">
                    <h4 class="fw-bold mb-4 border-bottom pb-2">Системна інформація</h4>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Повне ім'я</label>
                                <span class="fs-5 fw-bold">@Model.FullName</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Електронна пошта</label>
                                <span class="fs-5 fw-bold text-primary">@Model.Email</span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="p-3 bg-light rounded-3">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Компанія (GUID)</label>
                                <span class="text-muted font-monospace">@(Model.CompanyId?.ToString() ?? "Користувач не прив'язаний до компанії")</span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-5">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold border">
                            <i class="bi bi-arrow-left me-2"></i>Повернутися до списку
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>