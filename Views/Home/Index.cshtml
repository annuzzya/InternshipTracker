@{ ViewData["Title"] = "Головна - Дашборд"; }

<div class="container-fluid px-4 mt-4">
    <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
        <i class="bi bi-speedometer2 fs-2 text-primary me-3"></i>
        <h2 class="fw-bold m-0 text-dark">Аналітичний дашборд</h2>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Кількість вакансій для тайтлу</h5>
                    <div id="seniorityChart" style="height: 350px; width: 100%;">
                        <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                            <div class="spinner-border text-primary me-2" role="status"></div> Завантаження...
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Рівень зарплат на платформі</h5>
                    <div id="salaryChart" style="height: 350px; width: 100%;">
                        <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                            <div class="spinner-border text-primary me-2" role="status"></div> Завантаження...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="text/javascript">
        google.charts.load('current', {'packages':['corechart']});
        google.charts.setOnLoadCallback(drawCharts);

        function drawCharts() {
            
            // --- ГРАФІК 1: Плавний графік вакансій за Тайтлом ---
            fetch('/api/charts/vacanciesBySeniority')
                .then(response => response.json())
                .then(data => {
                    const dataTable = new google.visualization.DataTable();
                    dataTable.addColumn('string', 'Тайтл');
                    dataTable.addColumn('number', 'Кількість вакансій');

                    data.forEach(item => {
                        dataTable.addRow([item.title, item.count]);
                    });

                    const options = {
                        colors: ['#28a745'],
                        areaOpacity: 0.15, 
                        curveType: 'function',
                        legend: { position: 'none' }, 
                        chartArea: { width: '85%', height: '70%' },
                        pointSize: 5,       
                        animation: { startup: true, duration: 1200, easing: 'out' },
                        hAxis: { 
                            textStyle: { color: '#6c757d', fontSize: 11 },
                            slantedText: true, slantedTextAngle: 45 
                        },
                        vAxis: { 
                            textStyle: { color: '#6c757d' }, 
                            gridlines: { color: '#f8f9fa' }, 
                            baselineColor: '#dee2e6' 
                        }
                    };

                    const chart = new google.visualization.AreaChart(document.getElementById('seniorityChart'));
                    chart.draw(dataTable, options);
                });

            /// --- ГРАФІК 2: Гістограма зарплат (ColumnChart) ---
            fetch('/api/charts/vacanciesBySalary')
                .then(response => response.json())
                .then(data => {
                    const dataTable = new google.visualization.DataTable();
                    dataTable.addColumn('string', 'Категорія');
                    dataTable.addColumn('number', 'Кількість');
                    dataTable.addColumn({ type: 'string', role: 'style' });

                    const colors = ['#0dcaf0', '#198754', '#fd7e14', '#6c757d'];

                    data.forEach((item, index) => {
                        dataTable.addRow([item.category, item.count, colors[index]]);
                    });

                    const options = {
                        legend: { position: 'none' },
                        chartArea: { width: '85%', height: '70%' },
                        animation: { startup: true, duration: 1000, easing: 'out' },
                        bar: { groupWidth: '60%' }, 
                        hAxis: {
                            textStyle: { color: '#6c757d', fontSize: 11 },
                            slantedText: true, slantedTextAngle: 15
                        },
                        vAxis: {
                            textStyle: { color: '#6c757d' },
                            gridlines: { color: '#eaecf4' },
                            baselineColor: '#eaecf4'
                        }
                    };

                    const chart = new google.visualization.ColumnChart(document.getElementById('salaryChart'));
                    chart.draw(dataTable, options);
                });
        }
    </script>
}